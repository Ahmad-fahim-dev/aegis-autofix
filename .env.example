# AEGIS v1.0 — copy to .env and fill values. Never commit real secrets.

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# SQLite file URL used by Prisma (relative to prisma/schema.prisma).
# The db/ directory is gitignored runtime state — create it if missing:
#   mkdir -p db
DATABASE_URL="file:../db/custom.db"

# ---------------------------------------------------------------------------
# LLM bridge (optional — the engine degrades gracefully without it)
# ---------------------------------------------------------------------------
# Optional. Any OpenAI-compatible API key (Groq). Leave empty to run fully
# self-hosted with the deterministic heuristic engine: remediation falls back
# to safe templates and every LLM call is skipped rather than degraded.
GROQ_API_KEY=

# Default: llama-3.3-70b-versatile. The model whitelist also includes
# llama-3.1-8b-instant (faster/cheaper); values outside the whitelist are
# rejected by the settings API.
GROQ_MODEL="llama-3.3-70b-versatile"

# ---------------------------------------------------------------------------
# Realtime bridge (optional — fails closed when unset)
# ---------------------------------------------------------------------------
# Optional shared secret for the realtime /broadcast bridge (engine -> realtime
# service). When unset the bridge fails closed: no event is forwarded, and all
# events remain in the durable per-run event store.
AEGIS_BRIDGE_TOKEN=
